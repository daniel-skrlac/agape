{
  "expo": {
    "name": "Agape",
    "slug": "Agape",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agape",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "extra": {
      "eas": {
        "projectId": "a2e52c25-4bf3-48da-84b8-555786403588"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dskrlac.Agape"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.dskrlac.Agape"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 240,
          "ios": {
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#ffffff",
          "barStyle": "dark"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
