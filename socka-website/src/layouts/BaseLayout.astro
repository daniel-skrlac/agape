---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Socijalna samoposluga Kruh sv. Antuna', description = 'Volonterski projekt za pomoć najpotrebnijima u Varaždinu.' } = Astro.props;
const pageTitle = title.includes('Kruh sv. Antuna') ? title : `${title} | Kruh sv. Antuna`;
---
<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f97316" />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
