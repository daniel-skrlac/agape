---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absoluteUrl, site } from '../lib/site';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/800.css';
import '../styles/global.css';

interface MetaLink {
  label: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  breadcrumbs?: MetaLink[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = site.name,
  description = site.description,
  image = site.defaultImage,
  canonicalPath = Astro.url.pathname,
  type = 'website',
  noindex = false,
  breadcrumbs = [],
  structuredData
} = Astro.props;

const pageTitle = title.includes(site.shortName) ? title : `${title} | ${site.shortName}`;
const canonicalUrl = absoluteUrl(canonicalPath);
const imageUrl = absoluteUrl(image);
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: site.name,
  url: absoluteUrl('/'),
  logo: absoluteUrl(site.logo),
  description: site.description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: site.address.country
  },
  telephone: site.phone.display,
  email: site.email.display,
  parentOrganization: {
    '@type': 'Organization',
    name: site.affiliation.name
  }
};
const breadcrumbJsonLd =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.label,
          item: absoluteUrl(item.href)
        }))
      }
    : undefined;
const jsonLd = [organizationJsonLd, breadcrumbJsonLd, ...(Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [])].filter(Boolean);
---
<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#e45236" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64x64.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <slot name="head" />
    <ClientRouter />
    <title>{pageTitle}</title>
    {jsonLd.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Preskoči na sadržaj</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initSiteMotion } from '../scripts/motion';

      initSiteMotion();
    </script>
    <script is:inline>
      (() => {
        if (window.__sockaScrollNavigationReady) return;
        window.__sockaScrollNavigationReady = true;

        const scrollStateKey = 'socka:navigation-scroll-target';
        const sameOrigin = (url) => url.origin === window.location.origin;
        let pendingScrollTarget = null;

        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }

        const currentPath = () => `${window.location.pathname}${window.location.search}`;
        const writeScrollTarget = (target) => {
          pendingScrollTarget = target;

          try {
            sessionStorage.setItem(scrollStateKey, JSON.stringify(target));
          } catch {
            // Session storage can be unavailable in restricted browser modes.
          }
        };
        const readScrollTarget = () => {
          if (pendingScrollTarget) return pendingScrollTarget;

          try {
            const raw = sessionStorage.getItem(scrollStateKey);
            return raw ? JSON.parse(raw) : null;
          } catch {
            return null;
          }
        };
        const clearScrollTarget = () => {
          pendingScrollTarget = null;

          try {
            sessionStorage.removeItem(scrollStateKey);
          } catch {
            // No-op for restricted browser modes.
          }
        };
        const runAfterLayout = (callback) => {
          callback();
          requestAnimationFrame(callback);
          requestAnimationFrame(() => requestAnimationFrame(callback));
          window.setTimeout(callback, 40);
          window.setTimeout(callback, 140);
          window.setTimeout(callback, 320);
        };
        const jumpTo = (top) => {
          const root = document.documentElement;
          const body = document.body;
          const previousRootBehavior = root.style.scrollBehavior;
          const previousBodyBehavior = body.style.scrollBehavior;

          root.style.scrollBehavior = 'auto';
          body.style.scrollBehavior = 'auto';
          window.scrollTo({ top, left: 0, behavior: 'auto' });
          root.style.scrollBehavior = previousRootBehavior;
          body.style.scrollBehavior = previousBodyBehavior;
        };
        const scrollToTop = () => jumpTo(0);
        const scrollToElement = (element) => {
          const header = document.querySelector('[data-header]');
          const offset = header instanceof HTMLElement ? header.getBoundingClientRect().height + 14 : 14;
          const top = element.getBoundingClientRect().top + window.scrollY - offset;
          jumpTo(Math.max(0, top));
        };

        document.addEventListener(
          'click',
          (event) => {
            if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

            const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null;
            if (!anchor) return;

            const url = new URL(anchor.href, window.location.href);
            if (!sameOrigin(url) || anchor.target || anchor.hasAttribute('download')) return;

            const currentPath = `${window.location.pathname}${window.location.search}`;
            const nextPath = `${url.pathname}${url.search}`;
            if (currentPath === nextPath) {
              const hash = url.hash ? decodeURIComponent(url.hash.slice(1)) : '';
              writeScrollTarget({ path: nextPath, hash, createdAt: Date.now() });

              if (!hash) {
                requestAnimationFrame(scrollToTop);
              } else {
                const element = document.getElementById(hash);
                if (element) requestAnimationFrame(() => scrollToElement(element));
              }

              return;
            }

            writeScrollTarget({
              path: nextPath,
              hash: url.hash ? decodeURIComponent(url.hash.slice(1)) : '',
              createdAt: Date.now()
            });
          },
          true
        );

        const restoreExpectedScroll = () => {
          const target = readScrollTarget();
          if (!target || target.path !== currentPath()) return;
          if (Date.now() - Number(target.createdAt || 0) > 15000) {
            clearScrollTarget();
            return;
          }

          clearScrollTarget();

          runAfterLayout(() => {
            if (!target.hash) {
              scrollToTop();
              return;
            }

            const element = document.getElementById(target.hash);
            if (element) scrollToElement(element);
            else scrollToTop();
          });
        };

        window.addEventListener('pageshow', restoreExpectedScroll);
        document.addEventListener('astro:before-preparation', restoreExpectedScroll);
        document.addEventListener('astro:after-swap', restoreExpectedScroll);
        document.addEventListener('astro:page-load', restoreExpectedScroll);
      })();
    </script>
  </body>
</html>
