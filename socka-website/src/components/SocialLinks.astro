---
import BrandSocialIcon from './BrandSocialIcon.astro';
import ExternalLinkIcon from './icons/ExternalLinkIcon.astro';
import { publishedSocialLinks } from '../lib/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---
<div class:list={['social-grid', { 'social-grid--compact': compact }]}>
  {publishedSocialLinks.map((link) => (
    <a
      class={`social-grid__link social-grid__link--${link.id}`}
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${link.label} - otvara se u novoj kartici`}
    >
      <span class="social-grid__icon" aria-hidden="true">
        <BrandSocialIcon id={link.id} />
      </span>
      <span class="social-grid__label">
        <strong>{link.shortLabel}</strong>
      </span>
      <span class="social-grid__external" aria-hidden="true">
        <ExternalLinkIcon />
      </span>
    </a>
  ))}
</div>
