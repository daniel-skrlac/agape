---
import { formatDate } from '../lib/notices';
interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  image: string;
  imageAlt?: string;
  category?: string;
  featured?: boolean;
}
const { href, title, description, pubDate, image, imageAlt = '', category = 'Obavijest', featured = false } = Astro.props;
---
<a class:list={["notice-card", { "notice-card--featured": featured }]} href={href}>
  <span class="notice-card__image">
    <img src={image} alt={imageAlt || title} loading="lazy" />
  </span>
  <span class="notice-card__content">
    <span class="notice-card__meta">
      <span>{category}</span>
      <span>{formatDate(pubDate)}</span>
    </span>
    <strong>{title}</strong>
    <span>{description}</span>
  </span>
</a>
