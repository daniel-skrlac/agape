---
import BrandSocialIcon from './BrandSocialIcon.astro';
import ExternalLinkIcon from './icons/ExternalLinkIcon.astro';
import { navigation, publishedSocialLinks, site } from '../lib/site';

const currentPath = Astro.url.pathname;
---
<header class="site-header" data-header>
  <div class="top-strip" aria-label="Brzi kontakt">
    <div class="container top-strip__inner">
      <span>{site.location}</span>
      <span aria-hidden="true">/</span>
      <a href={`tel:${site.phone.href}`}>{site.phone.display}</a>
      {publishedSocialLinks.slice(0, 2).map((link) => (
        <a class="top-strip__external" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${link.shortLabel} - otvara se u novoj kartici`}>
          {link.shortLabel}
          <ExternalLinkIcon />
        </a>
      ))}
    </div>
  </div>
  <nav class="container navbar" aria-label="Glavna navigacija">
    <a class="brand" href="/" aria-label={`${site.name} - početna stranica`}>
      <img src={site.logo} alt="" width="56" height="56" loading="eager" />
      <span>
        <strong>{site.shortName}</strong>
        <small>Socijalna samoposluga Varaždin</small>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-controls="primary-navigation"
      aria-expanded="false"
      aria-label="Otvori navigaciju"
      data-nav-toggle
    >
      <span class="nav-toggle__lines" aria-hidden="true"></span>
      <span class="sr-only">Otvori navigaciju</span>
    </button>

    <div class="nav-backdrop" data-nav-backdrop aria-hidden="true"></div>

    <div class="nav-panel" id="primary-navigation" data-nav-panel>
      <div class="nav-panel__mobile-head">
        <span>Izbornik</span>
      </div>

      <ul class="nav-links">
        {navigation.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <li>
              <a class:list={[{ active: isActive }]} href={item.href} aria-current={isActive ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
      <a class="nav-cta" href="/kako-pomoci/">Želim pomoći</a>

      <div class="nav-panel__mobile-meta" aria-label="Brzi kontakt">
        <a class="nav-panel__contact" href={`tel:${site.phone.href}`}>
          <span>Telefon</span>
          <strong>{site.phone.display}</strong>
        </a>
        <div class="nav-panel__socials" aria-label="Društvene mreže">
          {publishedSocialLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${link.shortLabel} - otvara se u novoj kartici`}>
              <BrandSocialIcon id={link.id} />
              <span>{link.shortLabel}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  type HeaderCleanup = () => void;

  const headerWindow = window as typeof window & {
    sockaHeaderInit?: boolean;
    sockaHeaderCleanups?: WeakMap<HTMLElement, HeaderCleanup>;
    sockaHeaderRoots?: Set<HTMLElement>;
  };

  headerWindow.sockaHeaderCleanups ??= new WeakMap<HTMLElement, HeaderCleanup>();
  headerWindow.sockaHeaderRoots ??= new Set<HTMLElement>();

  const cleanupHeader = (header: HTMLElement) => {
    const cleanup = headerWindow.sockaHeaderCleanups?.get(header);
    if (cleanup) cleanup();
    headerWindow.sockaHeaderCleanups?.delete(header);
    headerWindow.sockaHeaderRoots?.delete(header);
  };

  const cleanupAllHeaders = () => {
    headerWindow.sockaHeaderRoots?.forEach((header) => cleanupHeader(header));
  };

  const resetGlobalNavState = () => {
    document.documentElement.classList.remove('nav-is-open');

    document.querySelectorAll('[data-header]').forEach((header) => {
      if (!(header instanceof HTMLElement)) return;

      const toggle = header.querySelector('[data-nav-toggle]');
      const panel = header.querySelector('[data-nav-panel]');
      header.classList.remove('nav-open');

      if (toggle instanceof HTMLButtonElement) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Otvori navigaciju');
        const label = toggle.querySelector('.sr-only');
        if (label) label.textContent = 'Otvori navigaciju';
      }

      if (panel instanceof HTMLElement) {
        panel.classList.remove('is-open');
        if (window.matchMedia('(max-width: 1020px)').matches) panel.setAttribute('inert', '');
      }
    });
  };

  const initHeaderNavigation = () => document.querySelectorAll('[data-header]').forEach((header) => {
    if (!(header instanceof HTMLElement) || header.dataset.navReady === 'true') return;

    const toggle = header.querySelector('[data-nav-toggle]');
    const panel = header.querySelector('[data-nav-panel]');
    const backdrop = header.querySelector('[data-nav-backdrop]');
    if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    header.dataset.navReady = 'true';
    headerWindow.sockaHeaderRoots?.add(header);

    const mobileQuery = window.matchMedia('(max-width: 1020px)');
    const focusableSelector = 'a[href], button:not([disabled])';
    let lastFocused: Element | null = null;
    let open = false;

    const keepViewportPosition = (scrollX: number, scrollY: number) => {
      requestAnimationFrame(() => {
        window.scrollTo({ left: scrollX, top: scrollY, behavior: 'auto' });
      });
    };

    const getFocusableElements = () => [toggle, ...panel.querySelectorAll(focusableSelector)].filter(
      (element): element is HTMLElement =>
        element instanceof HTMLElement &&
        !element.hasAttribute('disabled') &&
        element.getClientRects().length > 0
    );

    const syncMobileState = () => {
      if (mobileQuery.matches) {
        if (!open) panel.setAttribute('inert', '');
      } else {
        panel.removeAttribute('inert');
        document.documentElement.classList.remove('nav-is-open');
      }
    };

    const setOpen = (nextOpen: boolean, restoreFocus = true, preserveScroll = true) => {
      const currentScrollX = window.scrollX;
      const currentScrollY = window.scrollY;
      open = nextOpen && mobileQuery.matches;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Zatvori navigaciju' : 'Otvori navigaciju');
      panel.classList.toggle('is-open', open);
      header.classList.toggle('nav-open', open);
      const label = toggle.querySelector('.sr-only');
      if (label) label.textContent = open ? 'Zatvori navigaciju' : 'Otvori navigaciju';

      if (open) {
        lastFocused = document.activeElement;
        panel.removeAttribute('inert');
        if (preserveScroll) keepViewportPosition(currentScrollX, currentScrollY);
        return;
      }

      if (mobileQuery.matches) panel.setAttribute('inert', '');
      if (restoreFocus && lastFocused instanceof HTMLElement) lastFocused.focus({ preventScroll: true });
      if (preserveScroll) keepViewportPosition(currentScrollX, currentScrollY);
    };

    const onToggleClick = () => setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    const onPanelClick = (event: Event) => {
      const target = event.target;
      const link = target instanceof Element ? target.closest('a[href]') : null;
      if (link) {
        setOpen(false, false, false);
        resetGlobalNavState();
      }
    };
    const onBackdropClick = () => setOpen(false);
    const onKeydown = (event: KeyboardEvent) => {
      if (!open) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
        return;
      }
      if (event.key !== 'Tab') return;

      const focusable = getFocusableElements();
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (!(first instanceof HTMLElement) || !(last instanceof HTMLElement)) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };
    const onMediaChange = () => {
      if (!mobileQuery.matches) setOpen(false, false);
      syncMobileState();
    };

    toggle.addEventListener('click', onToggleClick);
    panel.addEventListener('click', onPanelClick);
    if (backdrop instanceof HTMLElement) backdrop.addEventListener('click', onBackdropClick);
    document.addEventListener('keydown', onKeydown);
    mobileQuery.addEventListener('change', onMediaChange);
    syncMobileState();

    headerWindow.sockaHeaderCleanups?.set(header, () => {
      setOpen(false, false);
      resetGlobalNavState();
      toggle.removeEventListener('click', onToggleClick);
      panel.removeEventListener('click', onPanelClick);
      if (backdrop instanceof HTMLElement) backdrop.removeEventListener('click', onBackdropClick);
      document.removeEventListener('keydown', onKeydown);
      mobileQuery.removeEventListener('change', onMediaChange);
      header.removeAttribute('data-nav-ready');
    });
  });

  cleanupAllHeaders();
  resetGlobalNavState();
  initHeaderNavigation();

  if (!headerWindow.sockaHeaderInit) {
    headerWindow.sockaHeaderInit = true;
    document.addEventListener('astro:before-preparation', resetGlobalNavState);
    document.addEventListener('astro:before-swap', () => {
      cleanupAllHeaders();
      resetGlobalNavState();
    });
    document.addEventListener('astro:after-swap', resetGlobalNavState);
    document.addEventListener('astro:page-load', () => {
      resetGlobalNavState();
      initHeaderNavigation();
    });
    window.addEventListener('pageshow', resetGlobalNavState);
  }
</script>
