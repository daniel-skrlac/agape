---
import { navigation, site } from '../lib/site';
const currentPath = Astro.url.pathname;
---
<header class="site-header" data-header>
  <div class="top-strip">
    <div class="container top-strip__inner">
      <span>{site.location}</span>
      <span class="top-strip__dot" aria-hidden="true"></span>
      <a href={site.social.facebook} target="_blank" rel="noreferrer">Facebook</a>
      <a href={site.social.instagram} target="_blank" rel="noreferrer">Instagram</a>
      <a href={site.social.tiktok} target="_blank" rel="noreferrer">TikTok</a>
      <a href={site.social.whatsapp} target="_blank" rel="noreferrer">WhatsApp grupa</a>
    </div>
  </div>
  <nav class="container navbar" aria-label="Glavna navigacija">
    <a class="brand" href="/" aria-label="Početna stranica">
      <img src="/images/logo.jpg" alt="Logo Socijalne samoposluge" width="52" height="52" />
      <span>
        <strong>{site.shortName}</strong>
        <small>Socijalna samoposluga</small>
      </span>
    </a>

    <input class="nav-toggle" id="nav-toggle" type="checkbox" aria-label="Otvori navigaciju" />
    <label class="nav-toggle-label" for="nav-toggle" aria-hidden="true"><span></span></label>

    <div class="nav-panel">
      <ul class="nav-links">
        {navigation.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <li>
              <a class:list={[{ active: isActive }]} href={item.href}>{item.label}</a>
            </li>
          );
        })}
      </ul>
      <a class="nav-cta" href="/kontakt/">Uključi se</a>
    </div>
  </nav>
</header>
