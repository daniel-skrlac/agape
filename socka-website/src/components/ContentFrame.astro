---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  number?: string;
}
const { eyebrow, title, text, number } = Astro.props;
---
<article class="content-frame">
  <div class="content-frame__top">
    <span class="content-frame__eyebrow">{eyebrow}</span>
    {number && <span class="content-frame__number">{number}</span>}
  </div>
  <h3>{title}</h3>
  <p>{text}</p>
  <div class="content-frame__placeholder" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
</article>
