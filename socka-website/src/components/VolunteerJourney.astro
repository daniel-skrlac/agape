---
const journeySteps = [
  {
    title: 'Javite se',
    text: 'Napišite tko se želi uključiti i kakav oblik pomoći vam je najbliži.'
  },
  {
    title: 'Dogovorite zadatak',
    text: 'Zajedno se bira realan termin, akcija ili posao koji u tom trenutku najviše koristi.'
  },
  {
    title: 'Dođite spremni',
    text: 'Volonterski rad je praktičan: sortiranje, slaganje, priprema paketa, akcije i komunikacija.'
  },
  {
    title: 'Ponesite iskustvo dalje',
    text: 'Dobar primjer se širi brzo. Jedna osoba često pokrene cijelu ekipu.'
  }
] as const;

const storyImages = [
  {
    src: '/images/recent/volonter-s-namirnicama.webp',
    alt: 'Volonter uz kutije s prikupljenim namirnicama',
    label: 'Prikupljanje i slaganje'
  },
  {
    src: '/images/recent/volonterke-u-samoposluzi.webp',
    alt: 'Volonterke u prostoru samoposluge uz namirnice',
    label: 'Timski rad u prostoru samoposluge'
  },
  {
    src: '/images/community/pripremljene-donacije.webp',
    alt: 'Pripremljene donacije u kutijama',
    label: 'Paketi spremni za podjelu'
  }
] as const;
---
<div class="volunteer-journey">
  <ol class="journey-steps">
    {journeySteps.map((step, index) => (
      <li class="reveal" style={`--i: ${index + 1}`}>
        <span>0{index + 1}</span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>

  <div class="story-strip" data-story-strip>
    <div class="story-strip__controls">
      <button type="button" data-story-prev aria-label="Prikaži prethodnu fotografiju">Prethodno</button>
      <button type="button" data-story-next aria-label="Prikaži sljedeću fotografiju">Sljedeće</button>
    </div>
    <div class="story-strip__track" tabindex="0" aria-label="Fotografije volonterskog rada" data-story-track>
      {storyImages.map((image) => (
        <figure>
          <img src={image.src} alt={image.alt} width="760" height="560" loading="lazy" />
          <figcaption>{image.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-story-strip]').forEach((strip) => {
    const track = strip.querySelector('[data-story-track]');
    const previous = strip.querySelector('[data-story-prev]');
    const next = strip.querySelector('[data-story-next]');
    if (!(track instanceof HTMLElement) || !(previous instanceof HTMLButtonElement) || !(next instanceof HTMLButtonElement)) return;

    const scrollByCard = (direction: number) => {
      const first = track.querySelector('figure');
      const amount = first instanceof HTMLElement ? first.offsetWidth + 16 : track.clientWidth * 0.8;
      track.scrollBy({ left: amount * direction, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };

    previous.addEventListener('click', () => scrollByCard(-1));
    next.addEventListener('click', () => scrollByCard(1));
  });
</script>
