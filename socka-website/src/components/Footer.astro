---
import SocialLinks from './SocialLinks.astro';
import { getPublicDonationConfig } from '../lib/donations/config';
import { footerNavigation, site } from '../lib/site';

const year = new Date().getFullYear();
const customerPortalUrl = getPublicDonationConfig().customerPortalUrl;
---
<footer class="site-footer">
  <div class="container footer-panel">
    <div class="footer-brand">
      <img src={site.logo} alt="" width="60" height="60" loading="lazy" />
      <div>
        <strong>{site.name}</strong>
        <p>Donacije, volonteri i akcije zajednice za pomoć ljudima u Varaždinu.</p>
      </div>
    </div>

    <div class="footer-links" aria-label="Podnožje navigacija">
      <h2>Stranice</h2>
      <ul>
        {footerNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        {customerPortalUrl && (
          <li><a href={customerPortalUrl} target="_blank" rel="noopener noreferrer">Upravljaj mjesečnom donacijom</a></li>
        )}
      </ul>
    </div>

    <div class="footer-social">
      <h2>Društvene mreže</h2>
      <SocialLinks compact />
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} {site.shortName}</span>
    <span>{site.address.display}</span>
  </div>
</footer>
