---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import VolunteerJourney from '../components/VolunteerJourney.astro';
import VolunteerRoles from '../components/VolunteerRoles.astro';
import { site } from '../lib/site';
---
<BaseLayout
  title="Volonteri"
  description="Uključite se kao volonter, škola, student, tvrtka ili skupina građana u rad Socijalne samoposluge Kruh sv. Antuna Varaždin."
  canonicalPath="/volonteri/"
  breadcrumbs={[
    { label: 'Početna', href: '/' },
    { label: 'Volonteri', href: '/volonteri/' }
  ]}
>
  <section class="volunteer-page-hero" data-scroll-story>
    <div class="container volunteer-page-hero__grid">
      <div class="volunteer-page-hero__copy reveal">
        <p class="eyebrow">Volonteri</p>
        <h1>Pridružite se volontiranju u Varaždinu.</h1>
        <p class="lead">
          Volontiranje je konkretno i jednostavno: javite se, dogovorimo termin i zajedno odaberemo zadatak koji najviše pomaže.
        </p>
        <div class="button-row">
          <a class="btn btn--primary btn--pulse" href="/kontakt/">Javi se za volontiranje</a>
          <a class="btn btn--secondary" href="#zadaci">Pogledaj zadatke</a>
        </div>
      </div>

      <div class="volunteer-page-hero__visual reveal" style="--i: 1">
        <figure class="volunteer-page-hero__photo volunteer-page-hero__photo--main">
          <img src="/images/recent/volonteri-potvrde-2026.webp" alt="Volonteri s potvrdama nakon završene volonterske aktivnosti" width="1400" height="782" loading="eager" />
        </figure>
        <figure class="volunteer-page-hero__photo volunteer-page-hero__photo--side">
          <img src="/images/recent/volonter-s-namirnicama.webp" alt="Volonter u prostoru Socijalne samoposluge uz prikupljene namirnice" width="1200" height="1600" loading="eager" />
        </figure>
        <div class="volunteer-page-hero__badge">
          <strong>Volja + dogovor</strong>
          <span>to je dovoljno za prvi korak</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section volunteer-roles-section" id="zadaci" data-scroll-story>
    <div class="container">
      <SectionTitle
        eyebrow="Zadaci"
        title="Odaberite zadatak koji vam najviše leži."
        text="Fotografija i objašnjenje mijenjaju se u istom slideru."
      />
      <VolunteerRoles />
    </div>
  </section>

  <section class="section section--white" data-scroll-story>
    <div class="container split-section split-section--balanced">
      <figure class="image-block image-block--wide reveal">
        <img src="/images/recent/volonter-s-namirnicama.webp" alt="Volonter u prostoru Socijalne samoposluge uz prikupljene namirnice" width="1200" height="1600" loading="lazy" />
      </figure>
      <div class="editorial-block reveal">
        <p class="eyebrow">Što volonteri rade</p>
        <h2>Svaki zadatak pomaže da donacija stigne dalje.</h2>
        <p>
          Volonteri pomažu u prikupljanju proizvoda, prijevozu, istovaru, slaganju polica, pripremi paketa, akcijama u trgovinama i komunikaciji s ljudima koji žele pomoći.
        </p>
        <p>
          Ne morate imati posebno iskustvo. Dovoljni su odgovornost, poštovanje i spremnost da se dio vremena daruje za nečiji mirniji dan.
        </p>
        <div class="button-row">
          <a class="btn btn--primary" href="/kontakt/">Javi se za volontiranje</a>
          <a class="btn btn--secondary" href="/kako-pomoci/">Drugi načini pomoći</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-scroll-story>
    <div class="container">
      <SectionTitle
        eyebrow="Volonterski put"
        title="Prvi dolazak može biti jednostavan."
        text="Od prve poruke do konkretnog zadatka, sve se dogovara jasno i bez pritiska."
      />
      <VolunteerJourney />
    </div>
  </section>

  <section class="section section--soft" data-scroll-story>
    <div class="container split-section">
      <div class="editorial-block reveal">
        <p class="eyebrow">Kako početi</p>
        <h2>Najbolji prvi korak je kratka poruka ili poziv.</h2>
        <p>{site.contactGuidance}</p>
        <p>
          Recite jeste li pojedinac, škola, grupa ili tvrtka, koliko ljudi se želi uključiti i kakav oblik pomoći vam je najbliži.
        </p>
      </div>
      <div class="volunteer-checklist reveal" aria-label="Priprema za volontiranje">
        <span>Odaberite oblik pomoći</span>
        <span>Dogovorite termin ili akciju</span>
        <span>Dođite spremni za konkretan zadatak</span>
        <span>Podijelite dobar primjer s drugima</span>
      </div>
    </div>
  </section>
</BaseLayout>
