---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnnouncementGrid from '../components/AnnouncementGrid.astro';
import EditorialGallery from '../components/EditorialGallery.astro';
import GoogleMapEmbed from '../components/GoogleMapEmbed.astro';
import HelpMethods from '../components/HelpMethods.astro';
import ImpactCounters from '../components/ImpactCounters.astro';
import InteractiveHero from '../components/InteractiveHero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import SocialLinks from '../components/SocialLinks.astro';
import VolunteerRoles from '../components/VolunteerRoles.astro';
import { historicalImpact, site } from '../lib/site';
import { getPublishedNotices } from '../lib/notices';

const notices = await getPublishedNotices();
---
<BaseLayout title="Početna" description={site.description} canonicalPath="/">
  <InteractiveHero />

  <section class="section section--announcements">
    <div class="container">
      <div class="section-head">
        <SectionTitle
          eyebrow="Aktualne obavijesti"
          title="Nove akcije i pozivi bit će odmah vidljivi."
          text="Kada postoji javna obavijest, prikazujemo tri najnovije. Bez izmišljanja hitnosti i bez neprovjerenih poziva."
        />
        <a class="text-link" href="/obavijesti/">Sve obavijesti</a>
      </div>
      <AnnouncementGrid notices={notices} limit={3} />
    </div>
  </section>

  <section class="section impact-section">
    <div class="container">
      <SectionTitle
        eyebrow="Učinak"
        title="Pomoć se vidi u paketima, satima i povjerenju."
        text="Pregled uključuje razdoblje od 2013. do kraja 2025. i nije živi brojač."
        align="center"
      />
      <ImpactCounters items={historicalImpact} />
    </div>
  </section>

  <section class="section section--soft help-preview">
    <div class="container">
      <SectionTitle
        eyebrow="Kako možete pomoći"
        title="Odaberite najlakši prvi korak."
        text="Možete donirati proizvode, volontirati, pokrenuti akciju ili uključiti školu, tvrtku i prijatelje."
      />
      <HelpMethods />
    </div>
  </section>

  <section class="section volunteer-home-section">
    <div class="container split-section split-section--balanced">
      <figure class="image-block image-block--wide reveal">
        <img src="/images/recent/volonterke-u-samoposluzi.webp" alt="Volonterke u prostoru Socijalne samoposluge uz prikupljene namirnice" width="1200" height="1600" loading="lazy" />
      </figure>
      <div class="editorial-block reveal">
        <p class="eyebrow">Volonteri</p>
        <h2>Dođite s voljom, a zadatak ćemo dogovoriti zajedno.</h2>
        <p>
          Volonteri preuzimaju donacije, sortiraju proizvode, slažu police, pripremaju pakete i pomažu u akcijama. Uključiti se može pojedinac, grupa, škola ili tvrtka.
        </p>
        <div class="button-row">
          <a class="btn btn--primary btn--pulse" href="/volonteri/">Što rade volonteri</a>
          <a class="btn btn--secondary" href="/kontakt/">Javi se</a>
        </div>
      </div>
    </div>
    <div class="container volunteer-home-roles">
      <VolunteerRoles compact />
    </div>
  </section>

  <section class="section location-section">
    <div class="container split-section">
      <div class="editorial-block reveal">
        <p class="eyebrow">Lokacija</p>
        <h2>Pronađite nas na karti i javite se prije dolaska.</h2>
        <p>
          Socijalna samoposluga djeluje u Varaždinu, na adresi {site.address.display}. Kratki poziv ili poruka pomažu da predaja donacije ili volontiranje budu dobro organizirani.
        </p>
        <div class="button-row">
          <a class="btn btn--primary" href={`tel:${site.phone.href}`}>Nazovi</a>
          <a class="btn btn--secondary" href={`mailto:${site.email.href}`}>Pošalji e-poštu</a>
        </div>
      </div>
      <GoogleMapEmbed />
    </div>
  </section>

  <section class="section gallery-section">
    <div class="container">
      <SectionTitle
        eyebrow="Zajednica"
        title="Rad se vidi u rukama, policama i pripremljenim paketima."
        text="Fotografije prikazuju volonterski rad i donacije, bez prikazivanja korisnika pomoći."
        align="center"
      />
      <EditorialGallery />
      <div class="social-section social-section--panel reveal">
        <div>
          <p class="eyebrow">Službeni kanali</p>
          <h2>Pratite akcije i podijelite pozive za pomoć.</h2>
        </div>
        <SocialLinks />
      </div>
    </div>
  </section>
</BaseLayout>
