---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnnouncementGrid from '../../components/AnnouncementGrid.astro';
import PageHero from '../../components/PageHero.astro';
import NoticeCard from '../../components/NoticeCard.astro';
import { getNoticeCategories, getPublishedNotices, noticeSlug, paginateNotices } from '../../lib/notices';

const allNotices = await getPublishedNotices();
const categories = getNoticeCategories(allNotices);
const requestedCategory = Astro.url.searchParams.get('kategorija') || '';
const activeCategory = categories.includes(requestedCategory) ? requestedCategory : '';
const filteredNotices = activeCategory
  ? allNotices.filter((notice) => notice.data.category === activeCategory)
  : allNotices;
const featured = filteredNotices.filter((notice) => notice.data.featured);
const featuredIds = new Set(featured.map((notice) => notice.id));
const regularNotices = filteredNotices.filter((notice) => !featuredIds.has(notice.id));
const requestedPage = Number(Astro.url.searchParams.get('stranica') || 1);
const { items: notices, currentPage, totalPages } = paginateNotices(
  regularNotices, Number.isFinite(requestedPage) ? Math.floor(requestedPage) : 1
);
const filterHref = (category: string, page = 1) => {
  const params = new URLSearchParams();
  if (category) params.set('kategorija', category);
  if (page > 1) params.set('stranica', String(page));
  return `/obavijesti/${params.size ? `?${params}` : ''}`;
};
---
<BaseLayout
  title="Obavijesti"
  description="Provjerene obavijesti, akcije i pozivi Socijalne samoposluge Kruh sv. Antuna Varaždin."
  canonicalPath="/obavijesti/"
  breadcrumbs={[
    { label: 'Početna', href: '/' },
    { label: 'Obavijesti', href: '/obavijesti/' }
  ]}
>
  <PageHero
    eyebrow="Obavijesti"
    title="Aktualne akcije, pozivi i novosti."
    text="Javne obavijesti i pozivi zajednici objavljuju se kada su spremni za dijeljenje."
  />

  <section class="section section--announcements" data-scroll-story>
    <div class="container">
      {categories.length > 0 && (
        <div class="filter-row" aria-label="Kategorije obavijesti">
          <span>Kategorije:</span>
          <a href="/obavijesti/" aria-current={!activeCategory ? 'page' : undefined}>Sve</a>
          {categories.map((category) => (
            <a href={filterHref(category)} aria-current={activeCategory === category ? 'page' : undefined}>{category}</a>
          ))}
        </div>
      )}
      {activeCategory && <p role="status">{activeCategory}: {filteredNotices.length} obavijesti</p>}

      {featured.length > 0 && (
        <div class="featured-notices">
          <h2>Izdvojeno</h2>
          <div class="notice-grid">
            {featured.map((notice) => (
              <NoticeCard
                href={`/obavijesti/${noticeSlug(notice.id)}/`}
                title={notice.data.title}
                description={notice.data.description}
                pubDate={notice.data.pubDate}
                eventDate={notice.data.eventDate}
                image={notice.data.image}
                imageAlt={notice.data.imageAlt}
                category={notice.data.category}
                featured={notice.data.featured}
              />
            ))}
          </div>
        </div>
      )}

      {notices.length > 0 && (
        <>
          <AnnouncementGrid notices={notices} />
          {totalPages > 1 && (
            <nav class="pagination" aria-label="Stranice obavijesti">
              <span>Stranica {currentPage} od {totalPages}</span>
              {currentPage > 1 && <a href={filterHref(activeCategory, currentPage - 1)} rel="prev">Prethodna</a>}
              {currentPage < totalPages && <a href={filterHref(activeCategory, currentPage + 1)} rel="next">Sljedeća</a>}
            </nav>
          )}
        </>
      )}

      {allNotices.length === 0 && (
        <AnnouncementGrid notices={[]} />
      )}
    </div>
  </section>
</BaseLayout>
