---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Misija, vizija i ciljevi" description="Misija, vizija i ciljevi sada su dio stranice O nama." canonicalPath="/o-nama/" noindex>
  <meta http-equiv="refresh" content="0; url=/o-nama/" slot="head" />
  <section class="section section--white">
    <div class="container empty-state empty-state--page">
      <p class="eyebrow">Preusmjerenje</p>
      <h1>Misija, vizija i ciljevi nalaze se na stranici O nama.</h1>
      <p>Ako preusmjeravanje ne počne automatski, otvorite stranicu O nama.</p>
      <a class="btn btn--primary" href="/o-nama/">O nama</a>
    </div>
  </section>
</BaseLayout>
